# путь к YAML с настройками, читается только из переменной окружения
PARKINGSCAN_CONFIG_FILE=configs/default.yaml

# переменные ниже переопределяют значения из YAML
PARKINGSCAN_LOG_LEVEL=INFO
PARKINGSCAN_MODELS_DIR=models
PARKINGSCAN_DATA_DIR=data
PARKINGSCAN_MAX_UPLOAD_MB=50
PARKINGSCAN_DEFAULT_CONF=0.25
